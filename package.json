{
  "name": "mimesis",
  "type": "module",
  "version": "3.0.0",
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "BRANCH=development vite",
    "build": "vue-tsc --noEmit && vite build && cap copy",
    "resources": "cordova-res --skip-config --copy --icon-background-source '#e67f3c'",
    "sync": "cap sync",
    "preview": "vite preview",
    "serve": "vite preview",
    "coverage": "vitest run --coverage",
    "test": "vitest --ui",
    "test:run": "vitest run",
    "seed": "ts-node --project ./node.tsconfig.json seed_db/import_db.ts",
    "types": "node ./scripts/getTypes.mjs",
    "dev-types": "BRANCH=development node ./scripts/getTypes.mjs",
    "lint:markup": "vue-tsc --noEmit",
    "lint:pretty": "prettier src/**/*.{css,vue}",
    "lint:script": "eslint ."
  },
  "dependencies": {
    "@capacitor-community/in-app-review": "^8.0.0",
    "@capacitor-community/keep-awake": "8.0.1",
    "@capacitor/app": "^8.1.0",
    "@capacitor/core": "^8.4.1",
    "@capacitor/device": "^8.0.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2",
    "@capgo/capacitor-updater": "8.49.7",
    "@capgo/native-audio": "^8.4.2",
    "@faker-js/faker": "10.5.0",
    "@headlessui/vue": "1.7.23",
    "@heroicons/vue": "2.2.0",
    "@intlify/unplugin-vue-i18n": "^11.2.4",
    "@ionic/vue": "8.8.11",
    "@ionic/vue-router": "8.8.11",
    "@revenuecat/purchases-capacitor": "^13.2.0",
    "@supabase/supabase-js": "2.108.2",
    "canvas-confetti": "1.9.4",
    "dotenv": "^17.4.2",
    "pinia": "3.0.4",
    "plausible-tracker": "^0.3.9",
    "tslib": "^2.8.1",
    "uuid": "^14.0.1",
    "vue": "3.5.38",
    "vue-i18n": "11.4.6",
    "vue-router": "5.1.0",
    "vue-timer-hook": "1.0.86",
    "windicss": "3.5.6"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.0.0",
    "@capacitor/android": "^8.4.1",
    "@capacitor/cli": "^8.4.1",
    "@capacitor/ios": "^8.4.1",
    "@types/canvas-confetti": "^1.9.0",
    "@types/jest": "30.0.0",
    "@vitejs/plugin-vue": "6.0.7",
    "@vitest/ui": "^4.1.9",
    "@vue/test-utils": "2.4.11",
    "csvtojson": "^2.0.14",
    "eslint": "10.5.0",
    "eslint-plugin-format": "^2.0.1",
    "jest-mock-random": "^1.1.1",
    "jsdom": "^29.1.1",
    "prettier": "3.8.4",
    "ts-node": "10.9.2",
    "typescript": "6.0.3",
    "vite": "8.1.0",
    "vite-plugin-environment": "1.1.3",
    "vite-plugin-windicss": "1.9.4",
    "vitest": "4.1.9",
    "vue-tsc": "3.3.5"
  },
  "lint-staged": {
    "*.{ts,vue}": "eslint --fix",
    "*.{ts,vue,css,json,md}": "prettier -w -u"
  }
}
