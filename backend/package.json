{
  "name": "mimesis-api",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler d1 migrations apply mimesis --remote && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "migrate:sql": "bun scripts/migrate-from-supabase.ts sql",
    "migrate:images": "bun scripts/migrate-from-supabase.ts images"
  },
  "dependencies": {
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261007.1",
    "@types/bun": "latest",
    "typescript": "^6.0.3",
    "wrangler": "^4.148.0"
  }
}
